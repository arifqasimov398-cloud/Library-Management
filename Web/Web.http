@Web_HostAddress = http://localhost:5238

### Kateqoriyalar

# @name romanCategory
POST {{Web_HostAddress}}/api/categories
Content-Type: application/json

{
  "name": "Roman123"
}

###

# @name elmiCategory
POST {{Web_HostAddress}}/api/categories
Content-Type: application/json

{
  "name": "Elmi"
}

###

GET {{Web_HostAddress}}/api/categories
Accept: application/json

### Kitablar

# @name aqQala
POST {{Web_HostAddress}}/api/books
Content-Type: application/json

{
  "title": "Ağ qala",
  "author": "Orxan Pamuk",
  "price": 12.50,
  "categoryId": "{{romanCategory.response.body.$.id}}"
}

###

POST {{Web_HostAddress}}/api/books
Content-Type: application/json

{
  "title": "Qara kitab",
  "author": "Orxan Pamuk",
  "price": 15.00,
  "categoryId": "{{romanCategory.response.body.$.id}}"
}

